#!/usr/bin/env python3
"""Render Halo's wallpaper pair and the overview colour fields.

Requires NumPy and Pillow. Outputs go to assets/halo/."""
from pathlib import Path
import sys

import numpy as np
from PIL import Image, ImageFilter

ROOT = Path(__file__).resolve().parents[1] / "assets" / "halo"
W, H = 3840, 2400
rng = np.random.default_rng(7)
y, x = np.mgrid[0:H, 0:W].astype(np.float32)
u = x / W * 1.6  # aspect-correct units: width 1.6, height 1.0
v = y / H


def hexc(h):
    h = h.lstrip("#")
    return np.array([int(h[i:i + 2], 16) for i in (0, 2, 4)], np.float32) / 255.0


def lerp(a, b, t):
    return a + (b - a) * t[..., None]


def grad(t, stops):
    t = np.clip(t, 0, 1)
    out = np.zeros(t.shape + (3,), np.float32)
    for (p0, c0), (p1, c1) in zip(stops, stops[1:]):
        m = (t >= p0) & (t <= p1)
        k = ((t - p0) / max(p1 - p0, 1e-6))[m]
        out[m] = hexc(c0) + (hexc(c1) - hexc(c0)) * k[:, None]
    return out


def soft(img, r):
    im = Image.fromarray((np.clip(img, 0, 1) * 255).astype(np.uint8)).filter(ImageFilter.GaussianBlur(r))
    return np.asarray(im).astype(np.float32) / 255


# ---------- HALO: a single luminous ring, tilted, right of centre ----------
def halo(dark):
    cx, cy, a, b, rot = 1.00, 0.58, 0.44, 0.235, np.deg2rad(-16)
    dx, dy = u - cx, v - cy
    xr = dx * np.cos(rot) + dy * np.sin(rot)
    yr = -dx * np.sin(rot) + dy * np.cos(rot)
    r = np.sqrt((xr / a) ** 2 + (yr / b) ** 2)
    theta = np.arctan2(yr / b, xr / a)  # -pi..pi
    d = (r - 1.0) * b  # approx distance in height units
    front = 0.5 + 0.5 * np.sin(theta)  # lower half of ring is nearer the viewer
    core = np.exp(-(d / 0.0045) ** 2)
    rim = np.exp(-(d / 0.018) ** 2)
    glow = np.exp(-(d / 0.09) ** 2)
    hue = (theta / (2 * np.pi) + 0.5)
    if dark:
        base = lerp(hexc("#05060c"), hexc("#0a0d1c"), np.clip(u / 1.6 * 0.7 + v * 0.3, 0, 1))
        ring = grad(hue, [(0, "#3a5cff"), (0.35, "#7b61ff"), (0.6, "#b49cff"), (0.8, "#7fe7ff"), (1, "#3a5cff")])
        bloom = np.exp(-(((u - 1.05) / 0.55) ** 2 + ((v - 0.66) / 0.42) ** 2))
        img = base + hexc("#1b2a8a") * (bloom * 0.35)[..., None]
        depth = (0.35 + 0.65 * front)[..., None]
        img = img + ring * depth * (glow * 0.28 + rim * 0.75)[..., None]
        img = img + np.array([1, 1, 1], np.float32) * (core * depth[..., 0] * 0.85)[..., None]
        vig = 1 - 0.35 * np.clip(((u - 0.9) / 1.2) ** 2 + ((v - 0.5) / 0.9) ** 2, 0, 1)
        img = img * vig[..., None]
    else:
        base = lerp(hexc("#f3f5fb"), hexc("#e2e7f4"), np.clip(u / 1.6 * 0.6 + v * 0.4, 0, 1))
        ring = grad(hue, [(0, "#2443e6"), (0.35, "#5b4be8"), (0.6, "#8c7cf0"), (0.8, "#38bdf8"), (1, "#2443e6")])
        bloom = np.exp(-(((u - 1.05) / 0.6) ** 2 + ((v - 0.66) / 0.45) ** 2))
        img = lerp(base, hexc("#c9d3f6"), bloom * 0.55)
        depth = 0.35 + 0.65 * front
        img = lerp(img, ring, np.clip((glow * 0.22 + rim * 0.75) * depth, 0, 1))
        img = lerp(img, hexc("#ffffff"), np.clip(core * depth * 0.95, 0, 1))
    return soft(img, 1.6)



def main():
    (ROOT / "wallpapers").mkdir(parents=True, exist_ok=True)
    (ROOT / "shell").mkdir(parents=True, exist_ok=True)
    for variant in ("light", "dark"):
        img = halo(variant == "dark")
        grain = rng.normal(0, 1.6 / 255, img.shape).astype(np.float32)
        wallpaper = Image.fromarray((np.clip(img + grain, 0, 1) * 255).astype(np.uint8))
        wallpaper.save(ROOT / "wallpapers" / f"halo-{variant}.jpg", quality=92, optimize=True, progressive=True)
        # The overview field: the wallpaper's light, diffused, behind the Shell when no blur runs.
        field = wallpaper.resize((960, 600), Image.Resampling.LANCZOS).filter(ImageFilter.GaussianBlur(28))
        tone = np.asarray(field).astype(np.float32) / 255
        tone = tone * 0.72 if variant == "dark" else 1 - (1 - tone) * 0.85
        Image.fromarray((np.clip(tone, 0, 1) * 255).astype(np.uint8)).resize(
            (1920, 1200), Image.Resampling.BICUBIC).save(ROOT / "shell" / f"halo-field-{variant}.png", optimize=True)
        print(f"Rendered Halo {variant}")


if __name__ == "__main__":
    sys.exit(main())
