#!/usr/bin/env python3
"""Package the compiled Halo theme and its source for installation."""
import argparse
from pathlib import Path
import subprocess
import tarfile
import tempfile

ROOT = Path(__file__).resolve().parent.parent
FILES = (
    "README.md", "LICENSE", "NOTICE.md", "src", "scripts", "assets/halo",
    "build/Halo-Light", "build/Halo-Dark", "build/halo",
    "docs/halo.md", "docs/halo-screenshots",
)


def package_entry(entry):
    if "__pycache__" in Path(entry.name).parts or entry.name.endswith(".pyc"):
        return None
    return entry


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--revision", type=int, default=1, help="version suffix to keep an earlier archive")
    args = parser.parse_args()
    if args.revision < 1:
        parser.error("revision must be positive")
    name = "halo-gnome-50"
    if args.revision > 1:
        name += f"-r{args.revision}"
    subprocess.run([ROOT / "scripts/build", "--family", "halo"], check=True)
    dist = ROOT / "dist"
    dist.mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(prefix=".halo-", dir=dist) as staging:
        archive = Path(staging) / f"{name}.tar.gz"
        with tarfile.open(archive, "w:gz") as package:
            for entry in FILES:
                package.add(ROOT / entry, arcname=f"{name}/{entry}", filter=package_entry)
        archive.replace(dist / archive.name)
    print(f"Packaged dist/{name}.tar.gz")


if __name__ == "__main__":
    main()
